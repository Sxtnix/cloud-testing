# ============================================================
# Pedidos360 — ejemplo de archivo .env
# ------------------------------------------------------------
# Copia este archivo como `.env` en la raiz del proyecto:
#     copy .env.example .env
# y completa los valores reales.  EL ARCHIVO `.env` ESTA EN
# .gitignore: NUNCA se sube al repositorio ni se comparte.
# ============================================================

# --- Autenticacion (Microsoft Entra ID) ---------------------
# false => login real con Microsoft Entra ID (valor por defecto).
# true  => PRUEBA LOCAL: se entra sin login de Azure y las APIs
#          no exigen JWT. Usarlo solo en desarrollo/pruebas.
AUTH_BYPASS=false

# --- Build del frontend (opcional, SOLO local) ---------------
# Si se omite, docker compose compila PRODUCCION (environment.prod.ts:
# login Azure + API Gateway). Poner "docker" solo en la maquina local:
# usa environment.docker.ts = login real de Microsoft pero con URLs
# localhost (18081/8082/8083) en vez del API Gateway.
# NG_BUILD_CONFIG=docker

# Issuer del tenant usado para validar los JWT (solo lectura en local).
# Si Tomy crea OTRO tenant/registro de Azure, este valor y los IDs del
# frontend se cambian según la sección 0.1 de GUIA-DESPLIEGUE.txt.
AZURE_ISSUER_URI=https://login.microsoftonline.com/9150f81f-b0fc-436d-998d-dcb5cf883d2e/v2.0

# --- Base de datos (ms-carrito) -----------------------------
# Por defecto H2. En docker-compose ya se fija un H2 en disco
# con volumen; solo definir si se usa MySQL/otro motor.
# DB_URL=jdbc:h2:file:/data/pedidos360_carrito
# DB_USERNAME=sa
# DB_PASSWORD=

# --- RabbitMQ ------------------------------------------------
# En docker-compose ya apunta al servicio `rabbitmq`; definer
# solo para un broker externo.
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=guest
# RABBITMQ_PASSWORD=guest

# --- Kafka (log de eventos para monitoreo) -------------------
# En docker-compose ya apunta al servicio `kafka`; definirlo solo
# para un broker externo.
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- ms-productos (fuente de verdad de precios/stock) -------
# En docker-compose apunta al servicio `ms-productos`.
# PRODUCTOS_SERVICE_URL=http://ms-productos:8081/productos

# --- ms-pagos (fuente de verdad del resultado del pago) -----
# En docker-compose apunta al servicio `ms-pagos` (interno, sin ruta publica).
# PAGOS_SERVICE_URL=http://ms-pagos:8085/pagos

# Siembra de 8 productos cuando la base arranca VACIA (default true).
# CATALOGO_SEED=false   # solo si se apunta a una BD con productos reales

# --- Correo (ms-email) --------------------------------------
# Credenciales REALES: solo en este archivo local, jamas en git.
# Sin credenciales el envio se degrada: el mensaje queda en la
# cola (retry) y la compra NO se ve afectada.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@pedidos360.cl

# --- Puerto del H2 console (ms-carrito, solo local) ---------
# H2_CONSOLE_PATH=/h2-console
